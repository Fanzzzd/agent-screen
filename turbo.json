{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "//#check:rust": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "apps/macos/**",
        "crates/**",
        "tests/e2e/**",
        "vendor/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    }
  }
}

{
  "name": "agent-screen-website",
  "account_id": "02f00bd6bcd6b515d4dac565f620d92c",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker sees www requests first so it can redirect them.
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "agentscreen.app", "custom_domain": true },
    { "pattern": "www.agentscreen.app", "custom_domain": true }
  ]
}
